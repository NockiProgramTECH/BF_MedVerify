# Pilotage du projet : "local" (PostgreSQL local) ou "online" (DATABASE_URL distante)
APP_ENV=local

# --- Mode local (utilise quand APP_ENV=local) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bfmv
POSTGRES_PASSWORD=bfmv
POSTGRES_DB=bfmv
# Optionnel en local : remplace les variables POSTGRES_* ci-dessus si defini
# LOCAL_DATABASE_URL=postgresql://bfmv:bfmv@localhost:5432/bfmv

# --- Mode en ligne (utilise quand APP_ENV=online) ---
# Compatible avec tout serveur PostgreSQL : Render, Neon, Railway, Koyeb, AWS RDS, VPS, Supabase URI, etc.
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:5432/nom_base?sslmode=require

# --- Secrets applicatifs (obligatoires en local comme en ligne) ---
BFMV_PEPPER=une-longue-valeur-secrete        # python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=une-autre-longue-valeur-secrete      # a mettre aussi dans l'URL du webhook : ?cle=...

# --- Passerelle SMS httpSMS (https://docs.httpsms.com) ---
# IMPORTANT :
# - La "Phone API Key" (https://httpsms.com/phone-api-keys) se saisit UNIQUEMENT dans l'app Android httpSMS.
# - Ici sur le serveur, renseignez la cle API principale du compte (https://httpsms.com/settings).
# En mode APP_ENV=online, l'envoi reel s'active automatiquement des que HTTPSMS_API_KEY est definie.
# En mode APP_ENV=local, decommenter HTTPSMS_ENABLED=true uniquement si vous voulez envoyer de vrais SMS :
# HTTPSMS_ENABLED=true
HTTPSMS_API_KEY=votre-cle-compte-httpsms
HTTPSMS_FROM_NUMBER=+22670000000             # numero E.164 de la carte SIM du telephone Android
HTTPSMS_WEBHOOK_SIGNING_KEY=cle-signature-webhook-httpsms-32-caracteres-min   # Settings > Webhooks dans httpSMS
HTTPSMS_ALERT_TO=                            # optionnel : numero E.164 recevant les alertes Faso FDA
